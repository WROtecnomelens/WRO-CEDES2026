// ===================================================== 

// ==================== LIBRERIAS ====================== 

// ===================================================== 

 

#include <Wire.h> 

#include <HUSKYLENS.h> 

#include <Servo.h> 

#include <LiquidCrystal_I2C.h> 

 

// ===================================================== 

// ==================== LCD ============================ 

// ===================================================== 

 

LiquidCrystal_I2C lcd(0x27,16,2); 

 

// ===================================================== 

// ==================== TB6612 ========================= 

// ===================================================== 

 

#define PWMA 9 

#define AIN1 8 

#define AIN2 10 

 

#define PWMB 11 

#define BIN1 12 

#define BIN2 13 

 

// ===================================================== 

// ==================== ENCODERS ======================= 

// ===================================================== 

 

#define ENC_IZQ A3 

#define ENC_DER A2 

 

volatile long contIzq=0; 

volatile long contDer=0; 

 

bool estadoAntIzq=LOW; 

bool estadoAntDer=LOW; 

 

// ===================================================== 

// ==================== SERVOS ========================= 

// ===================================================== 

 

Servo servoDir; 

Servo servoCam; 

 

// ===================================================== 

// ==================== HUSKYLENS ====================== 

// ===================================================== 

 

HUSKYLENS husky; 

 

// IDs HuskyLens 

 

#define ID_NARANJA 1 

#define ID_AZUL 2 

 

// Sentido circuito 

 

bool sentidoConfigurado=false; 

 

int colorGiro=0; 

int colorRecta=0; 

 

// Último ID leído 

 

int ultimoID=0; 

 

// ===================================================== 

// ==================== PID VELOCIDAD ================== 

// ===================================================== 

 

float Kp=1.2; 

float Ki=0.4; 

float Kd=0.02; 

 

float Tm=0.05; 

 

float eI=0,eI1=0,eI2=0; 

float cvI=0,cvI1=0; 

 

float eD=0,eD1=0,eD2=0; 

float cvD=0,cvD1=0; 

 

// ===================================================== 

// ==================== VELOCIDADES ==================== 

// ===================================================== 

 

float velIzq=0; 

float velDer=0; 

 

float velDeseada=180; 

 

// ===================================================== 

// ==================== DIRECCION ====================== 

// ===================================================== 

 

int direccion=90; 

 

float KpDir=0.7; 

float KdDir=0.2; 

 

float errorDireccion=0; 

float errorPrev=0; 

 

// ===================================================== 

// ==================== ESTADOS ======================== 

// ===================================================== 

 

enum Estado{ 

 

RECTA, 

GIRANDO 

 

}; 

 

Estado estado=RECTA; 

 

// ===================================================== 

 

unsigned long tPID=0; 

unsigned long tLCD=0; 

 

// ===================================================== 

// ==================== SETUP ========================== 

// ===================================================== 

 

void setup(){ 

 

Serial.begin(9600); 

 

pinMode(AIN1,OUTPUT); 

pinMode(AIN2,OUTPUT); 

 

pinMode(BIN1,OUTPUT); 

pinMode(BIN2,OUTPUT); 

 

pinMode(PWMA,OUTPUT); 

pinMode(PWMB,OUTPUT); 

 

pinMode(ENC_IZQ,INPUT); 

pinMode(ENC_DER,INPUT); 

 

servoDir.attach(A1); 

servoCam.attach(A0); 

 

servoDir.write(90); 

 

// Servo cámara fijo mirando delante 

 

servoCam.write(110); 

 

Wire.begin(); 

 

husky.begin(Wire); 

 

lcd.init(); 

lcd.backlight(); 

 

lcd.setCursor(0,0); 

lcd.print("OPEN CHALLENGE"); 

 

delay(1500); 

 

lcd.clear(); 

 

} 

 

// ===================================================== 

// ==================== LOOP =========================== 

// ===================================================== 

 

void loop(){ 

 

leerEncoders(); 

 

// ===================================================== 

// ================= CALCULO VELOCIDAD ================ 

// ===================================================== 

 

if(millis()-tPID>=50){ 

 

velIzq=contIzq*20; 

velDer=contDer*20; 

 

contIzq=0; 

contDer=0; 

 

tPID=millis(); 

 

} 

 

// ===================================================== 

// ==================== HUSKYLENS ====================== 

// ===================================================== 

 

if(husky.request()){ 

 

if(husky.available()){ 

 

HUSKYLENSResult r=husky.read(); 

 

Serial.print("ID:"); 

Serial.println(r.ID); 

 

// CONFIGURAR SENTIDO 

 

if(!sentidoConfigurado){ 

 

if(r.ID==ID_NARANJA){ 

 

colorGiro=ID_NARANJA; 

colorRecta=ID_AZUL; 

 

sentidoConfigurado=true; 

 

Serial.println("HORARIO"); 

 

} 

 

else if(r.ID==ID_AZUL){ 

 

colorGiro=ID_AZUL; 

colorRecta=ID_NARANJA; 

 

sentidoConfigurado=true; 

 

Serial.println("ANTIHORARIO"); 

 

} 

 

} 

 

// ENTRAR GIRO 

 

if( 

 

sentidoConfigurado && 

r.ID==colorGiro && 

ultimoID!=colorGiro && 

estado==RECTA 

 

){ 

 

estado=GIRANDO; 

 

Serial.println("GIRO"); 

 

} 

 

// VOLVER RECTA 

 

if( 

 

sentidoConfigurado && 

r.ID==colorRecta && 

ultimoID!=colorRecta && 

estado==GIRANDO 

 

){ 

 

estado=RECTA; 

 

errorPrev=0; 

 

Serial.println("RECTA"); 

 

} 

 

ultimoID=r.ID; 

 

} 

 

else{ 

 

ultimoID=0; 

 

} 

 

} 

 

// ===================================================== 

// ================= MAQUINA ESTADOS =================== 

// ===================================================== 

 

switch(estado){ 

 

case RECTA:{ 

 

direccion=90; 

 

velDeseada=200; 

 

break; 

 

} 

 

case GIRANDO:{ 

 

errorDireccion=30; 

 

float deriv= 

 

errorDireccion- 

errorPrev; 

 

float correccion= 

 

KpDir*errorDireccion+ 

KdDir*deriv; 

 

errorPrev=errorDireccion; 

 

direccion= 

 

90+ 

(int)correccion; 

 

direccion= 

 

constrain( 

direccion, 

90, 

130 

); 

 

velDeseada=120; 

 

break; 

 

} 

 

} 

 

// ===================================================== 

 

servoDir.write(direccion); 

 

// ===================================================== 

// ================= PID IZQUIERDO ===================== 

// ===================================================== 

 

eI=velDeseada-velIzq; 

 

cvI= 

 

cvI1+ 

(Kp+Kd/Tm)*eI+ 

(-Kp+Ki*Tm-2*Kd/Tm)*eI1+ 

(Kd/Tm)*eI2; 

 

cvI1=cvI; 

 

eI2=eI1; 

eI1=eI; 

 

// ===================================================== 

// ================= PID DERECHO ======================= 

// ===================================================== 

 

eD=velDeseada-velDer; 

 

cvD= 

 

cvD1+ 

(Kp+Kd/Tm)*eD+ 

(-Kp+Ki*Tm-2*Kd/Tm)*eD1+ 

(Kd/Tm)*eD2; 

 

cvD1=cvD; 

 

eD2=eD1; 

eD1=eD; 

 

// ===================================================== 

 

cvI=constrain(cvI,80,255); 

cvD=constrain(cvD,80,255); 

 

moverMotores( 

 

(int)cvI, 

(int)cvD 

 

); 

 

// ===================================================== 

// ==================== LCD ============================ 

// ===================================================== 

 

if(millis()-tLCD>=200){ 

 

float velMedia=(velIzq+velDer)/2.0; 

 

lcd.setCursor(0,0); 

lcd.print("                "); 

 

lcd.setCursor(0,0); 

 

lcd.print("V:"); 

lcd.print(velMedia); 

 

lcd.print(" A:"); 

lcd.print(direccion); 

 

lcd.setCursor(0,1); 

lcd.print("                "); 

 

lcd.setCursor(0,1); 

 

lcd.print("Modo:"); 

 

if(estado==RECTA) 

lcd.print("RECTA"); 

 

if(estado==GIRANDO) 

lcd.print("GIRO"); 

 

tLCD=millis(); 

 

} 

 

delay(10); 

 

} 

 

// ===================================================== 

// ==================== MOTORES ======================== 

// ===================================================== 

 

void moverMotores(int velIzqPWM,int velDerPWM){ 

 

digitalWrite(AIN1,HIGH); 

digitalWrite(AIN2,LOW); 

 

analogWrite( 

PWMA, 

velIzqPWM 

); 

 

digitalWrite(BIN1,HIGH); 

digitalWrite(BIN2,LOW); 

 

analogWrite( 

PWMB, 

velDerPWM 

); 

 

} 

 

// ===================================================== 

// ==================== ENCODERS ======================= 

// ===================================================== 

 

void leerEncoders(){ 

 

bool lecturaIzq= 

digitalRead(ENC_IZQ); 

 

bool lecturaDer= 

digitalRead(ENC_DER); 

 

if( 

lecturaIzq==HIGH && 

estadoAntIzq==LOW 

){ 

 

contIzq++; 

 

} 

 

estadoAntIzq= 

lecturaIzq; 

 

if( 

lecturaDer==HIGH && 

estadoAntDer==LOW 

){ 

 

contDer++; 

 

} 

 

estadoAntDer= 

lecturaDer; 

 

} 
